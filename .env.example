# Qdrant Vector Database (required)
# Get your credentials from https://cloud.qdrant.io/
QDRANT_URL=your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key

# Groq API Key (for LLM) — at least one of Groq or OpenAI required
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your-groq-api-key

# OpenAI API Key (optional, alternative to Groq)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Tavily API Key (optional) — enables the web_search sub-agent. Without it,
# the agent simply doesn't route to web search; nothing else is affected.
# Free tier at https://tavily.com
# TAVILY_API_KEY=your-tavily-api-key

# Conversation memory: SQLite file path for server-side conversation history
# (POST /query's conversation_id). Default: .artemis/conversations.db
# ARTEMIS_MEMORY_DB_PATH=.artemis/conversations.db

# Neo4j (optional) — enables GraphRAG: a "graph" search_mode for multi-hop
# questions and extract_graph on ingest_file. Without these, nothing changes
# (no graph search_mode offered, extract_graph param not shown to the agent).
# Free AuraDB instance at https://console.neo4j.io -- note the username Aura
# generates is often the instance id, not literally "neo4j"; check your
# instance's connection details.
# NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
# NEO4J_USERNAME=your-username
# NEO4J_PASSWORD=your-password

# Agent Layer Configuration (optional)
# LLM provider: "groq" (default) or "openai"
ARTEMIS_LLM_PROVIDER=groq

# Model name (provider-specific)
# Groq default: "openai/gpt-oss-120b" (llama-3.3-70b-versatile was removed from Groq's catalog)
# OpenAI default: "gpt-4o-mini"
ARTEMIS_LLM_MODEL=openai/gpt-oss-120b

# Generation parameters
ARTEMIS_MAX_TOKENS=2048
ARTEMIS_TEMPERATURE=0.7

# Retrieval parameters
ARTEMIS_RETRIEVAL_K=5

# Optional — only for Kaggle dataset downloads (e.g. dataset/). Not required for the agent or API.
# Get your credentials from https://www.kaggle.com/account
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-key

# Optional: Custom dataset cache location
# KAGGLEHUB_CACHE=/path/to/cache

# Logging Configuration
# Set log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
ARTEMIS_LOG_LEVEL=INFO

# Document Storage Configuration
# Set to "true" to save documents to files (useful for testing/large datasets)
# Default: false (in-memory mode, faster for small datasets)
ARTEMIS_SAVE_DOCS_TO_DISK=true

# CORS: comma-separated list of extra browser origins allowed to call the API
# (e.g. your deployed frontend's URL). http://localhost:5173 (Vite dev) is
# always allowed and does not need to be listed here.
ARTEMIS_CORS_ORIGINS=https://your-frontend.vercel.app

# API authentication (optional): comma-separated key:tenant_id pairs.
# Unset (default) = auth disabled, every request runs as a single "default"
# tenant -- the original no-friction local/demo behavior. Set this to require
# callers to send "Authorization: Bearer <key>" or "X-API-Key: <key>"; each
# key's requests are then isolated to that tenant's own collections (see
# artemis/auth.py for exactly which operations that covers).
# ARTEMIS_API_KEYS=changeme-key-1:tenant_a,changeme-key-2:tenant_b

# Per-tenant rate limit for POST /query (requests per 60s window). Default: 30.
# ARTEMIS_RATE_LIMIT_PER_MINUTE=30
