# Local dev against a locally-running backend (docker compose up / python -m artemis.api)
VITE_API_BASE_URL=http://localhost:8000

# To point at the live demo backend instead, use:
# VITE_API_BASE_URL=http://54.87.62.83:8000

# For a Cloudflare-tunnel demo where backend+frontend run on the same machine, leave this
# empty — requests go relative to the frontend's own origin and vite.config.ts proxies them
# to localhost:8000, so only the frontend needs a public tunnel:
# VITE_API_BASE_URL=
